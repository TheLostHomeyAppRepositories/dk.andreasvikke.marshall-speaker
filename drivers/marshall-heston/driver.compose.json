{
  "id": "marshall-heston",
  "name": {
    "en": "Marshall Heston",
    "fr": "Marshall Heston"
  },
  "class": "speaker",
  "capabilities": [
    "volume_set",
    "volume_mute",
    "speaker_track",
    "speaker_artist",
    "speaker_album",
    "heston_pause",
    "heston_preset",
    "heston_bass",
    "heston_treble",
    "heston_source",
    "heston_sound_mode"
  ],
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/marshall-speaker/assets/images/small.png",
    "large": "/drivers/marshall-speaker/assets/images/large.png",
    "xlarge": "/drivers/marshall-speaker/assets/images/xlarge.png"
  },
  "settings": [
    {
      "id": "address",
      "type": "text",
      "label": {
        "en": "IP Address",
        "fr": "Adresse IP"
      },
      "hint": {
        "en": "The local IP address of the Heston soundbar.",
        "fr": "L'adresse IP locale de la barre de son Heston."
      }
    }
  ],
  "discovery": "marshall_heston_mdns",
  "pair": [
    {
      "id": "list_my_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_my_devices"
      }
    },
    {
      "id": "add_my_devices",
      "template": "add_devices"
    }
  ]
}
